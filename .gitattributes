# Normalise every text file to LF line endings (Windows checkouts would
# otherwise add CRLF, which the Moodle coding style rejects).
* text=auto eol=lf

# Deliberate exceptions - never convert these:
# - CRLF test fixtures used to check the CRLF detection.
tests/fixtures/crlf.csv -text
# - Bundled third-party code is kept byte-for-byte as released upstream
#   (it includes its own CRLF and mixed-ending test files).
vendor/** -text

# Kept out of the release zip built by .github/workflows/release.yml (git
# archive) and out of GitHub's automatic "Source code" downloads.
/.github export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
